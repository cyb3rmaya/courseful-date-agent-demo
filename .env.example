# 실제 날씨: https://www.data.go.kr/data/15084084/openapi.do 에서 활용신청 후 발급
KMA_SERVICE_KEY=

# Kakao 지도 브라우저 SDK용 공개 플랫폼 키(허용 도메인 제한 필수)
KAKAO_JAVASCRIPT_KEY=

# Kakao Local 장소 검색용 서버 비밀 키
KAKAO_REST_API_KEY=

# 물리적으로 다른 컴퓨터에 MCP Server를 띄울 때만 설정
# WEATHER_MCP_URL=https://weather.example.com/mcp
# TOUR_MCP_URL=https://tour.example.com/mcp

# CLI AI Agent(06_mcp_call.py)에만 필요. 공개 웹 앱에는 불필요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
