{
  "version": 2,
  "servers": {
    "weather": {
      "transport": "streamable_http",
      "url": "http://127.0.0.1:8101/mcp",
      "url_env": "WEATHER_MCP_URL",
      "command": "{python}",
      "args": ["weather_mcp_server.py", "--host", "127.0.0.1", "--port", "8101"],
      "enabled": true
    },
    "tour": {
      "transport": "streamable_http",
      "url": "http://127.0.0.1:8102/mcp",
      "url_env": "TOUR_MCP_URL",
      "command": "{python}",
      "args": ["tour_mcp_server.py", "--host", "127.0.0.1", "--port", "8102"],
      "enabled": true
    }
  }
}
